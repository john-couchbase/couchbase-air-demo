# Cluster. Locally: Couchbase Server in Docker (see README). On sbx-27:
# couchbases://cb.<id>.cloud.couchbase.com and a database user. See
# docs/MOVING-TO-CAPELLA.md.
CB_CONN=couchbase://localhost
CB_USER=Administrator
CB_PASS=
CB_BUCKET=aidp-air
# CB_CERT_PATH=infra/certs/capella-ca.pem   # only if TLS verification fails

# Capella Management API, for scripts/deploy_models.py only.
CAPELLA_API_KEY=
CAPELLA_ORG_ID=
# CAPELLA_API_BASE=https://cloudapi.cloud.couchbase.com

# backend: the app calls the model per message (sees every token and cache verdict).
# sqlpp:   the Query service runs the AI Function statement (tokens estimated).
CLASSIFY_VIA=backend

# Models. "local" serves every catalog entry from LM Studio and labels every
# figure as a stand-in. deploy_models.py sets model_service and writes the
# per-job endpoints below, plus MODEL_API_KEY.
MODEL_BACKEND=local
MODEL_BASE_URL=http://localhost:1234/v1
MODEL_API_KEY=lm-studio
LOCAL_SMALL_MODEL=meta-llama-3.1-8b-instruct
LOCAL_FRONTIER_MODEL=meta-llama-3.1-8b-instruct

# Surge shape. The defaults suit one laptop GPU; raise both on the sandbox.
# SURGE_SIZE=320
# SURGE_SECONDS=240

# Pause messages and model calls after this many minutes with no browser
# watching (a visible tab); 0 never pauses. Every classified message can land
# in the Model Service's semantic cache, so an unwatched demo fills it.
# IDLE_PAUSE_MIN=10

# Written by scripts/deploy_models.py; one deployment per job.
# CLASSIFY_BASE_URL=
# CLASSIFY_MODEL_NAME=
# AGENT_BASE_URL=
# AGENT_MODEL_NAME=
# EMBED_BASE_URL=
# EMBED_MODEL_NAME=
