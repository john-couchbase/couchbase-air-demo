# Sandbox-like local mode: the laptop runs the demo the way sbx-27 runs it.
#   cp .env.sandbox-local.example .env.sandbox-local    # then fill in CB_PASS
#   AIDP_ENV=sandbox-local ./scripts/present.sh
# Needs the local Couchbase container and LM Studio with Llama 3.1 8B, the
# nomic embedding model and (for CLASSIFY_VIA=sqlpp) Mistral 7B loaded.

# The local cluster, same as .env.local.
CB_CONN=couchbase://localhost
CB_USER=Administrator
CB_PASS=
CB_BUCKET=aidp-air

# The app in its remote mode, pointed at the gateway stand-in instead of Capella.
MODEL_BACKEND=model_service
MODEL_BASE_URL=http://localhost:8020/v1
MODEL_API_KEY=local-gateway

# As on the sandbox: classification through AI Functions, hits estimated from
# statement time, a fresh cache space per run, no X-cb-cache strategy header.
CLASSIFY_VIA=sqlpp
SQLPP_CACHE_HIT_MS=300
CACHE_PER_RUN=true
MODEL_CACHE_STRATEGY=

# Whether the local ai_completion uses the gateway's cache. On sbx-27 this is
# the open dev-team question: true to see the demo if AI Functions do use it,
# false to see what happens if they skip it.
SANDBOX_AI_FUNCTIONS_USE_CACHE=true

# The gateway stand-in (aidpair/gateway.py).
# A cache hit's latency; sbx-27 measured about 100 ms.
GATEWAY_HIT_MS=100
# Added to every response, to imitate a slow network to Capella.
GATEWAY_EXTRA_MS=0
# 1 to see the demo as if semantic caching were fixed.
GATEWAY_SEMANTIC_WORKS=0
